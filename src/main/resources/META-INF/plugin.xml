<idea-plugin>
    <id>org.nomolang.intellij</id>
    <name>Nomo</name>
    <vendor url="https://github.com/nomo-lang">nomo-lang</vendor>

    <description><![CDATA[
        Nomo language support for JetBrains IDEs: diagnostics, completion and
        semantic highlighting powered by the <code>nomo-lsp</code> language server
        through <a href="https://github.com/redhat-developer/lsp4ij">LSP4IJ</a>.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Nomo"
            language="Nomo"
            implementationClass="org.nomolang.intellij.NomoFileType"
            fieldName="INSTANCE"
            extensions="nomo"/>
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server
            id="nomo"
            name="Nomo Language Server"
            factoryClass="org.nomolang.intellij.NomoLanguageServerFactory">
            <description><![CDATA[
                Nomo language server (<code>nomo-lsp</code>). Provides diagnostics,
                completion and semantic tokens for <code>.nomo</code> files.
            ]]></description>
        </server>
        <languageMapping language="Nomo" serverId="nomo" languageId="nomo"/>
    </extensions>
</idea-plugin>
